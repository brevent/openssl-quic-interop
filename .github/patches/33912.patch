+int ossl_quic_sstream_get_first_unacked(QUIC_SSTREAM *qss, uint64_t from,
+    uint64_t *start, uint64_t *end)
+{
+    UINT_SET_ITEM *acked;
+
+    *start = from;
+    for (acked = ossl_list_uint_set_head(&qss->acked_set); acked != NULL;
+        acked = ossl_list_uint_set_next(acked)) {
