From 571957dc44e654cb8947b18791b06a4456157b92 Mon Sep 17 00:00:00 2001
From: Liu Dongmiao <473522+liudongmiao@users.noreply.github.com>
Date: Wed, 18 Nov 2026 12:30:52 +0800
Subject: [PATCH 01/12] quic: do not skip CRYPTO ranges after the first frame
 in a packet

txp_generate_crypto_frames() used the same counter to skip ranges of
pending CRYPTO data and to walk the iovecs of each frame. After the
first frame, the skip count was left at the number of iovecs, so later
ranges were passed over and sent in a following packet. Use a separate
counter for the iovecs.

Assisted-by: Claude:claude-opus-5-5
---
 ssl/quic/quic_txp.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/ssl/quic/quic_txp.c b/ssl/quic/quic_txp.c
index ebba1cf070316..a2491a7ee3bf1 100644
--- a/ssl/quic/quic_txp.c
+++ b/ssl/quic/quic_txp.c
@@ -2156,7 +2156,7 @@ static int txp_generate_crypto_frames(OSSL_QUIC_TX_PACKETISER *txp,
     uint64_t hdr_bytes;
     WPACKET *wpkt;
     QUIC_TXPIM_CHUNK chunk = { 0 };
-    size_t i, space_left;
+    size_t i, j, space_left;
 
     for (i = 0;; ++i) {
         space_left = tx_helper_get_space_left(h);
@@ -2212,8 +2212,8 @@ static int txp_generate_crypto_frames(OSSL_QUIC_TX_PACKETISER *txp,
             return 0; /* alloc error */
 
         /* Add payload iovecs to the helper (infallible). */
-        for (i = 0; i < num_stream_iovec; ++i)
-            tx_helper_append_iovec(h, iov[i].buf, iov[i].buf_len);
+        for (j = 0; j < num_stream_iovec; ++j)
+            tx_helper_append_iovec(h, iov[j].buf, iov[j].buf_len);
 
         *have_ack_eliciting = 1;
         tx_helper_unrestrict(h); /* no longer need PING */

From eba331c1a7f0e90b81dbb37b6138c048e41536a0 Mon Sep 17 00:00:00 2001
From: Liu Dongmiao <473522+liudongmiao@users.noreply.github.com>
Date: Wed, 18 Nov 2026 12:33:48 +0800
Subject: [PATCH 02/12] quic: clear pending probe requests when a space is
 discarded

A PTO or anti-deadlock probe still pending for the Initial or Handshake
space could no longer be sent once that space was discarded, so every
later datagram was built as a probe, outside congestion control. Clear
the requests along with the other state of the space.

Assisted-by: Claude:claude-opus-5-5
---
 ssl/quic/quic_ackm.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/ssl/quic/quic_ackm.c b/ssl/quic/quic_ackm.c
index bd0fb966e3b42..8e2577a37b7f3 100644
--- a/ssl/quic/quic_ackm.c
+++ b/ssl/quic/quic_ackm.c
@@ -1329,6 +1329,11 @@ int ossl_ackm_on_pkt_space_discarded(OSSL_ACKM *ackm, int pkt_space)
     ackm->time_of_last_ack_eliciting_pkt[pkt_space] = ossl_time_zero();
     ackm->loss_time[pkt_space] = ossl_time_zero();
     ackm->pto_count = 0;
+    ackm->pending_probe.pto[pkt_space] = 0;
+    if (pkt_space == QUIC_PN_SPACE_INITIAL)
+        ackm->pending_probe.anti_deadlock_initial = 0;
+    else if (pkt_space == QUIC_PN_SPACE_HANDSHAKE)
+        ackm->pending_probe.anti_deadlock_handshake = 0;
     ackm->discarded[pkt_space] = 1;
     ackm->ack_eliciting_bytes_in_flight[pkt_space] = 0;
     ackm_set_loss_detection_timer(ackm);

From 05ad7b147a470ae98f860ad6719060b4a2eda9d8 Mon Sep 17 00:00:00 2001
From: Liu Dongmiao <473522+liudongmiao@users.noreply.github.com>
Date: Wed, 18 Nov 2026 12:35:48 +0800
Subject: [PATCH 03/12] quic: handle send stream data sent in more than one
 packet

To let a PTO probe resend data while its original packet stays in
flight, the send stream must handle one copy being ACKed while another
is declared lost, and the same bytes being ACKed twice with different
boundaries.

Lost ranges now skip ACKed bytes, and ACKed ranges leave the new set
before they are recorded, so no byte is ever in both sets, even on
allocation failure. A UINT_SET insert that overlaps existing ranges now
also merges with a range it touches, as other inserts already do.

Assisted-by: Claude:claude-opus-5-5
---
 ssl/quic/quic_sstream.c | 31 ++++++++++++++++++++++++++++++-
 ssl/quic/uint_set.c     |  5 +++++
 2 files changed, 35 insertions(+), 1 deletion(-)

diff --git a/ssl/quic/quic_sstream.c b/ssl/quic/quic_sstream.c
index 314104addcb00..e909b30b5f765 100644
--- a/ssl/quic/quic_sstream.c
+++ b/ssl/quic/quic_sstream.c
@@ -211,13 +211,37 @@ int ossl_quic_sstream_mark_lost(QUIC_SSTREAM *qss,
     uint64_t end)
 {
     UINT_RANGE r;
+    UINT_SET_ITEM *acked;
+
     r.start = start;
     r.end = end;
 
     /*
      * We lost a range of stream data bytes, so reinsert them into the new set,
      * so that they are returned once more by ossl_quic_sstream_get_stream_frame.
+     * Bytes already ACKed in another packet, such as a PTO probe, are skipped.
      */
+    for (acked = ossl_list_uint_set_tail(&qss->acked_set);
+        acked != NULL && acked->range.end >= r.start;
+        acked = ossl_list_uint_set_prev(acked)) {
+        if (acked->range.start > r.end)
+            continue;
+
+        if (acked->range.end < r.end) {
+            UINT_RANGE gap;
+
+            gap.start = acked->range.end + 1;
+            gap.end = r.end;
+            if (!ossl_uint_set_insert(&qss->new_set, &gap))
+                return 0;
+        }
+
+        if (acked->range.start <= r.start)
+            return 1;
+
+        r.end = acked->range.start - 1;
+    }
+
     if (!ossl_uint_set_insert(&qss->new_set, &r))
         return 0;
 
@@ -243,7 +267,12 @@ int ossl_quic_sstream_mark_acked(QUIC_SSTREAM *qss,
     r.start = start;
     r.end = end;
 
-    if (!ossl_uint_set_insert(&qss->acked_set, &r))
+    /*
+     * A copy of the range may still be queued for retransmission. Remove it
+     * first, so that a failure never leaves a byte both NEW and ACKED.
+     */
+    if (!ossl_uint_set_remove(&qss->new_set, &r)
+        || !ossl_uint_set_insert(&qss->acked_set, &r))
         return 0;
 
     qss_cull(qss);
diff --git a/ssl/quic/uint_set.c b/ssl/quic/uint_set.c
index 4b723869e853d..bcb5af3ee079c 100644
--- a/ssl/quic/uint_set.c
+++ b/ssl/quic/uint_set.c
@@ -218,6 +218,11 @@ int ossl_uint_set_insert(UINT_SET *s, const UINT_RANGE *range)
                 ossl_list_uint_set_remove(s, x);
                 OPENSSL_free(x);
             }
+
+            /* The merged range may now touch its neighbours. */
+            uint_set_merge_adjacent(s, ovend);
+            if ((x = ossl_list_uint_set_next(ovend)) != NULL)
+                uint_set_merge_adjacent(s, x);
             break;
         } else if (end < z->range.start
             && (zprev == NULL || start > zprev->range.end)) {

From 14edd6d35762ccd5ff592116c2588594468856f1 Mon Sep 17 00:00:00 2001
From: Liu Dongmiao <473522+liudongmiao@users.noreply.github.com>
Date: Wed, 18 Nov 2026 12:50:39 +0800
Subject: [PATCH 04/12] quic: resend unacknowledged Initial CRYPTO data in PTO
 probes

A PTO probe carried only PING when no new CRYPTO data was pending, so
the ClientHello was not retransmitted until its packet was declared
lost, which a long RTT delays past the server's reply.

Request two probes on an Initial PTO, as RFC 9002 s. 6.2.4 allows,
counting any still pending from an earlier PTO, and fill each with the
next unacknowledged Initial CRYPTO data that fits. Initial CRYPTO data
still queued, such as the tail of a ClientHello larger than the
congestion window, goes out first. A CRYPTO frame is ACK-eliciting, so
it may use the byte reserved for PING, and a probe can carry as much as
the packet it resends. A ClientHello of two packets can then be resent
in full, and anything beyond the two probes stays in flight. When one
probe carries all that is left, or nothing is left, a single probe is
sent.

Fixes #33758

Assisted-by: Claude:claude-opus-5-5
