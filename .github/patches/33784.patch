From 557ff9843eece3133e08f28c3d85bf4f163a4d99 Mon Sep 17 00:00:00 2001
From: Liu Dongmiao <473522+liudongmiao@users.noreply.github.com>
Date: Tue, 24 Nov 2026 15:55:23 +0800
Subject: [PATCH] quic-openssl-docker: support the multiconnect test case

The interop runner uses the multiconnect test case for the handshakeloss
(L1) and handshakecorruption (C1) tests, which run_endpoint.sh rejected
as unsupported.

On the server, except on Windows, serve each accepted connection in a
detached thread, with the QUIC domain in multi-threaded blocking mode.

Assisted-by: Claude:claude-opus-5-5
---
 .../hq-interop/quic-hq-interop-server.c       | 148 +++++++++++-------
 test/quic-openssl-docker/run_endpoint.sh      |  13 +-
 2 files changed, 105 insertions(+), 56 deletions(-)

diff --git a/test/quic-openssl-docker/hq-interop/quic-hq-interop-server.c b/test/quic-openssl-docker/hq-interop/quic-hq-interop-server.c
index 7c8b18ff0ccc3..c11cf9fa52cd2 100644
--- a/test/quic-openssl-docker/hq-interop/quic-hq-interop-server.c
+++ b/test/quic-openssl-docker/hq-interop/quic-hq-interop-server.c
@@ -47,6 +47,7 @@
 #else
 #include <sys/socket.h>
 #include <netinet/in.h>
+#include <pthread.h>
 #include <unistd.h>
 #endif
 
@@ -197,6 +198,13 @@ static SSL_CTX *create_ctx(const char *cert_path, const char *key_path)
     if (ctx == NULL)
         goto err;
 
+#ifndef _WIN32
+    /* Connection threads make concurrent blocking calls in one QUIC domain. */
+    if (!SSL_CTX_set_domain_flags(ctx,
+            SSL_DOMAIN_FLAG_MULTI_THREAD | SSL_DOMAIN_FLAG_BLOCKING))
+        goto err;
+#endif
+
     /*
      * Load the server's certificate *chain* file (PEM format), which includes
      * not only the leaf (end-entity) server certificate, but also any
@@ -562,6 +570,8 @@ static void process_new_stream(SSL *stream)
     return;
 }
 
+static void *serve_connection(void *arg);
+
 /**
  * @brief Runs the QUIC server to accept and handle client connections.
  *
@@ -579,7 +589,7 @@ static void process_new_stream(SSL *stream)
  * - Creates a QUIC listener using the provided SSL_CTX and associates it
  *   with the specified UDP socket.
  * - Waits for incoming QUIC connections and accepts them.
- * - For each connection:
+ * - For each connection, in its own thread except on Windows:
  *   - Accepts incoming streams.
  *   - Processes each stream using `process_new_stream`.
  *   - Shuts down the connection upon completion.
@@ -601,8 +611,10 @@ static void process_new_stream(SSL *stream)
 static int run_quic_server(SSL_CTX *ctx, BIO *sock)
 {
     int ok = 0;
-    SSL *listener, *conn, *stream;
-    unsigned long errcode;
+    SSL *listener, *conn;
+#ifndef _WIN32
+    pthread_t thread;
+#endif
     uint64_t flags = 0;
 
     /*
@@ -644,68 +656,94 @@ static int run_quic_server(SSL_CTX *ctx, BIO *sock)
         }
         printf("Accepted new connection\n");
 
-        /*
-         * QUIC requires that we inform the connection that
-         * we always want to accept new streams, rather than reject them
-         * Additionally, while we don't make an explicit call here, we
-         * are using the default stream mode, as would be specified by
-         * a call to SSL_set_default_stream_mode
-         */
-        if (!SSL_set_incoming_stream_policy(conn,
-                SSL_INCOMING_STREAM_POLICY_ACCEPT,
-                0)) {
-            fprintf(stderr, "Failed to set incoming stream policy\n");
-            goto close_conn;
+#ifdef _WIN32
+        serve_connection(conn);
+#else
+        if (pthread_create(&thread, NULL, serve_connection, conn) != 0) {
+            fprintf(stderr, "Failed to create thread\n");
+            SSL_free(conn);
+            continue;
         }
+        pthread_detach(thread);
+#endif
+    }
+
+err:
+    SSL_free(listener);
+    return ok;
+}
+
+/**
+ * @brief Serves a QUIC connection until the client closes it, then frees it.
+ *
+ * @param arg Pointer to the SSL object representing the QUIC connection.
+ * @return Always NULL.
+ */
+static void *serve_connection(void *arg)
+{
+    SSL *conn = arg;
+    SSL *stream;
+    unsigned long errcode;
 
+    /*
+     * QUIC requires that we inform the connection that
+     * we always want to accept new streams, rather than reject them
+     * Additionally, while we don't make an explicit call here, we
+     * are using the default stream mode, as would be specified by
+     * a call to SSL_set_default_stream_mode
+     */
+    if (!SSL_set_incoming_stream_policy(conn,
+            SSL_INCOMING_STREAM_POLICY_ACCEPT,
+            0)) {
+        fprintf(stderr, "Failed to set incoming stream policy\n");
+        goto close_conn;
+    }
+
+    /*
+     * Until the connection is closed, accept incoming stream
+     * requests and serve them
+     */
+    for (;;) {
         /*
-         * Until the connection is closed, accept incoming stream
-         * requests and serve them
+         * Note that SSL_accept_stream is blocking here, as the
+         * conn SSL object inherited the default blocking property
+         * from its parent, the listener SSL object.  As such there
+         * is no need to handle retry failures here.
          */
-        for (;;) {
+        stream = SSL_accept_stream(conn, 0);
+        if (stream == NULL) {
             /*
-             * Note that SSL_accept_stream is blocking here, as the
-             * conn SSL object inherited the default blocking property
-             * from its parent, the listener SSL object.  As such there
-             * is no need to handle retry failures here.
+             * If we don't get a stream, either we
+             * Hit a legitimate error, and should bail out
+             * or
+             * The Client closed the connection, and there are no
+             * more incoming streams expected
+             *
+             * Filter on the shutdown error, and only print an error
+             * message if the cause is not SHUTDOWN
              */
-            stream = SSL_accept_stream(conn, 0);
-            if (stream == NULL) {
-                /*
-                 * If we don't get a stream, either we
-                 * Hit a legitimate error, and should bail out
-                 * or
-                 * The Client closed the connection, and there are no
-                 * more incoming streams expected
-                 *
-                 * Filter on the shutdown error, and only print an error
-                 * message if the cause is not SHUTDOWN
-                 */
-                ERR_print_errors_fp(stderr);
-                errcode = ERR_get_error();
-                if (ERR_GET_REASON(errcode) != SSL_R_PROTOCOL_IS_SHUTDOWN)
-                    fprintf(stderr, "Failure in accept stream, error %s\n",
-                        ERR_reason_error_string(errcode));
-                break;
-            }
-            process_new_stream(stream);
-            SSL_free(stream);
+            ERR_print_errors_fp(stderr);
+            errcode = ERR_get_error();
+            if (ERR_GET_REASON(errcode) != SSL_R_PROTOCOL_IS_SHUTDOWN)
+                fprintf(stderr, "Failure in accept stream, error %s\n",
+                    ERR_reason_error_string(errcode));
+            break;
         }
+        process_new_stream(stream);
+        SSL_free(stream);
+    }
 
-        /*
-         * Shut down the connection. We may need to call this multiple times
-         * to ensure the connection is shutdown completely.
-         */
-    close_conn:
-        while (SSL_shutdown(conn) != 1)
-            continue;
+    /*
+     * Shut down the connection. We may need to call this multiple times
+     * to ensure the connection is shutdown completely.
+     */
+close_conn:
+    while (SSL_shutdown(conn) != 1)
+        continue;
 
-        SSL_free(conn);
-    }
+    SSL_free(conn);
 
-err:
-    SSL_free(listener);
-    return ok;
+    return NULL;
 }
 
 /**
diff --git a/test/quic-openssl-docker/run_endpoint.sh b/test/quic-openssl-docker/run_endpoint.sh
index 51b2022d340f0..65c44244e0e06 100644
--- a/test/quic-openssl-docker/run_endpoint.sh
+++ b/test/quic-openssl-docker/run_endpoint.sh
@@ -75,6 +75,17 @@ if [ "$ROLE" == "client" ]; then
         done
         exit 0
         ;;
+    "multiconnect")
+        for req in $REQUESTS
+        do
+            OUTFILE=$(basename $req)
+            echo -n "$OUTFILE " > ./reqfile.txt
+            HOSTNAME=$(printf "%s\n" "$req" | sed -ne 's,^https://\([^/:]*\).*,\1,p')
+            HOSTPORT=$(printf "%s\n" "$req" | sed -ne 's,^https://[^:/]*:\([^/]*\).*,\1,p')
+            SSLKEYLOGFILE=/logs/keys.log SSL_CERT_FILE=/certs/ca.pem SSL_CERT_DIR=/certs quic-hq-interop $HOSTNAME $HOSTPORT ./reqfile.txt || exit 1
+        done
+        exit 0
+        ;;
     "chacha20")
         for req in $REQUESTS
         do
@@ -95,7 +106,7 @@ elif [ "$ROLE" == "server" ]; then
     echo "TESTCASE is $TESTCASE"
     rm -f $CURLRC 
     case "$TESTCASE" in
-    "handshake"|"transfer"|"ipv6")
+    "handshake"|"transfer"|"ipv6"|"multiconnect")
         NO_ADDR_VALIDATE=yes SSLKEYLOGFILE=/logs/keys.log FILEPREFIX=/www quic-hq-interop-server 443 /certs/cert.pem /certs/priv.key
         ;;
     "retry")
